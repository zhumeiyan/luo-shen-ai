# ============================================================
# 洛神AI - 安全 .gitignore（修复：运行数据/密钥/媒体不入库）
# ============================================================

# ---- 敏感配置与密钥（绝不提交） ----
.env
.env.*
*.pem
*.key
*.pfx
*.crt
perception_input/luoshen_service_config.json
perception_input/*config*.json

# ---- 运行日志与状态数据（运行时生成，非源码） ----
*.jsonl
*.log
# ---- 例外：哈希链日志必须入链（洛神历史完整性的唯一证据） ----
!hash_chain_v2.log
!hash_chain_v2.backup.log
!hash_chain_v2.log.bak
!hash_chain_v2.log.after_A
!hash_chain_v2.log.after_B
!hash_chain_v2.log.experiment_initial
!hash_chain.log
ai_hospital_rules.json
precheck_report.json
external_diagnosis_report.json
rules_update_001.json
blackbox_deprecated.json
perception_input/self_core_state.json

# ---- 媒体与大文件（运行时产物/个人数据） ----
*.wav
*.mp4
*.avi
*.mov
*.zip
perception_input/video_frame.jpg

# ---- 临时 / 构建产物 ----
temp/
output/
__pycache__/
*.pyc

# ---- 本地 Gitee 上传记录 ----
perception_input/gitee_upload_info.jsonl
# ---- 洛神感官产物：她看过/说出/合成的东西（运行产物，不入库） ----
luoshen_voice/
luoshen_video/
*.mp3
